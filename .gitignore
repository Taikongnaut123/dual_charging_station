#==============================================================================
#  只提交源码。以下全部是构建产物与本地状态，一律不入库。
#
#  写法约定：目录名**不带**前导斜杠 → 任意层级同名目录都忽略。
#            例如 build/ 同时覆盖 ./build/ 和 ./ros2_ws/build/
#==============================================================================

#────────────────────────────────────────────── Qt / qmake 构建产物
build/
build-*/
debug/
release/
.qmake.stash
Makefile
Makefile.*
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.gch

# qmake / uic / moc / rcc 自动生成的文件
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
qrc_*.h
ui_*.h

# 注意：.ts 是翻译源文件，要提交；.qm 才是编译产物
.qm/
*.qm

# Qt Creator 的工程本地设置与自动保存
*.pro.user
*.pro.user.*
*.ui.autosave
*.autosave
CMakeLists.txt.user*
.qmake.cache

#────────────────────────────────────────────── 打包产物
# tools/make_package.sh 的输出（CI 与本地打包都走它）
dist/

#────────────────────────────────────────────── ROS2 / colcon
# colcon 的三个空间（build/ 上面已覆盖，这里保留 install/ 与 log/）
install/
log/
# rosidl 生成物（正常情况下落在 build/ 里，这里兜底）
ros2_ws/src/*/rosidl_generator_*/
__pycache__/
*.py[cod]

#────────────────────────────────────────────── 编辑器 / IDE
# CMake 扩展会往 settings.json 写本机绝对路径，不适合共享；
# 若要共享该设置，请改成 ${workspaceFolder}/ros2_ws/src/mdc_serial 再删掉这行
.vscode/settings.json
.vscode/ipch/
.vscode/browse.vc.db*
.vscode/*.log
.idea/
*.kdev4
.cache/
.clangd/
.ccls-cache/
compile_commands.json

#────────────────────────────────────────────── 日志与临时文件
*.log
logs/
*.bak
*.tmp
*.orig
*.rej
*~
*.swp
*.swo
*.swn

#────────────────────────────────────────────── 操作系统
.DS_Store
Thumbs.db
desktop.ini


# 没有 HOME 时（例如 systemd 拉起、且 unit 没设 HOME）累计统计会落到这里
/config/
